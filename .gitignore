.DS_Store

# Secrets and machine-specific environment files
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials*.json

# Python
.venv/
backend/.venv-*/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Personal lecture records (SQLite, legacy JSON, WAL and backups)
backend/data/*
!backend/data/.gitkeep
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Transient media and local model caches
backend/tmp/
backend/uploads/
backend/downloads/
*.webm
*.wav
*.mp3
*.m4a
*.mp4
models/
*.gguf
*.safetensors
*.ckpt
*.pt
*.pth
.cache/
.huggingface/
.ollama/
*.log

# Frontend
frontend/node_modules/
frontend/dist/
