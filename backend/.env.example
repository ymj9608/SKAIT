# Apple Silicon 권장: mlx_whisper
# 기타 선택지: demo | huggingface | faster_whisper
STT_PROVIDER=mlx_whisper
HF_TOKEN=
HF_STT_MODEL=openai/whisper-large-v3
LOCAL_WHISPER_MODEL=small
MLX_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# 토큰 없는 생성형 로컬 LLM: ollama
# 기타 선택지: local(추출식 폴백) | huggingface
LLM_PROVIDER=ollama
HF_LLM_MODEL=openai/gpt-oss-120b:fastest
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_CONTEXT_WINDOW=8192
OLLAMA_KEEP_ALIVE=15m

# 30초 녹음 구간 10개(약 5분)마다 중간 AI 노트를 갱신합니다.
SUMMARY_INTERVAL_SEGMENTS=10

# 콤마로 구분합니다.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 개인 기록이 저장되는 SQLite DB입니다. Git에 올리지 않습니다.
DATABASE_FILE=data/reclass.sqlite3
# 0.1.x 버전의 JSON 기록이 있으면 최초 한 번 자동으로 가져옵니다.
DATA_FILE=data/sessions.json
MAX_AUDIO_MB=25
